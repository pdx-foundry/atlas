{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdx-foundry.github.io/atlas/rule-snapshot-v1.schema.json",
  "title": "Atlas rule snapshot version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "atlas_rule_snapshot"
    },
    "contract_version": {
      "const": 1
    },
    "schema_dialect": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "builds"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "established_properties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "whole_registry_validity": {
          "const": "not_established"
        },
        "native_support": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "const": "Supported"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "Unsupported": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "Unsupported"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "registries",
        "established_properties",
        "whole_registry_validity",
        "native_support"
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "$defs": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "propertyNames": {
            "pattern": "^reader-.+"
          }
        }
      },
      "required": [
        "$schema",
        "$defs"
      ]
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "required": [
    "kind",
    "contract_version",
    "schema_dialect",
    "snapshot",
    "generator",
    "applicability",
    "coverage",
    "sources",
    "schemas",
    "subjects",
    "rules",
    "gaps"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1
        },
        "native_version": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "Declared",
            "StaticAnalysis",
            "LiveObservation",
            "Recorded"
          ]
        }
      },
      "required": [
        "build",
        "native_version",
        "method",
        "basis"
      ]
    },
    "native_gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "UnnamedRegistries",
            "OutsideMethod",
            "UnreadableInput",
            "UnnamedField",
            "UnresolvedPath",
            "UnresolvedReader",
            "ReaderSemantics",
            "IncompleteObservation"
          ]
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "subject",
        "detail"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "completeness": {
          "enum": [
            "Complete",
            "Partial"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "native_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_gap"
          }
        }
      },
      "required": [
        "source",
        "completeness",
        "location",
        "native_gaps"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(registry|field):[^#]+$"
        },
        "kind": {
          "enum": [
            "registry",
            "field"
          ]
        },
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "conditional": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "registry"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(registry|field):[^#]+#[a-z][a-z0-9._]*$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "not": {
            "type": "null"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "subject",
        "property",
        "conditions",
        "answer",
        "evidence"
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(registry|field):[^#]+#[a-z][a-z0-9._]*$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^SDK-[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_gap"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "subject",
        "property",
        "reason",
        "owner",
        "native_gaps",
        "evidence"
      ]
    }
  }
}
