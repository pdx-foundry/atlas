{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdx-foundry.github.io/atlas/rule-snapshot-v2.schema.json",
  "title": "Atlas rule snapshot version 2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "atlas_rule_snapshot"
    },
    "contract_version": {
      "const": 2
    },
    "schema_dialect": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "builds"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "established_properties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "whole_registry_validity": {
          "const": "not_established"
        },
        "native_support": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "const": "Supported"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "Unsupported": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "Unsupported"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "registries",
        "established_properties",
        "whole_registry_validity",
        "native_support"
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/answer"
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "$defs": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "propertyNames": {
            "pattern": "^reader-.+"
          }
        }
      },
      "required": [
        "$schema",
        "$defs"
      ]
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "required": [
    "kind",
    "contract_version",
    "schema_dialect",
    "snapshot",
    "generator",
    "applicability",
    "coverage",
    "sources",
    "answers",
    "schemas",
    "subjects",
    "rules",
    "gaps"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1
        },
        "native_version": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "Declared",
            "StaticAnalysis",
            "LiveObservation",
            "Recorded"
          ]
        }
      },
      "required": [
        "build",
        "native_version",
        "method",
        "basis"
      ]
    },
    "native_gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "UnnamedRegistries",
            "OutsideMethod",
            "UnreadableInput",
            "UnnamedField",
            "UnnamedDeclaration",
            "UnresolvedPath",
            "UnresolvedReader",
            "ReaderSemantics",
            "IncompleteObservation"
          ]
        },
        "subject": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["registry", "field", "answer_item", "localization_link", "fixture_file"] },
                "name": { "type": "string" }
              },
              "required": ["kind", "name"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["localization_context", "scope_type"] },
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string" }
              },
              "required": ["kind", "id", "name"]
            }
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "subject",
        "detail"
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "completeness": {
          "enum": [
            "Complete",
            "Partial"
          ]
        },
        "native_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_gap"
          }
        }
      },
      "required": [
        "source",
        "completeness",
        "native_gaps"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "native_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_gap"
          }
        }
      },
      "required": [
        "answer",
        "location",
        "native_gaps"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z_]+:[^#]+$"
        },
        "kind": {
          "enum": [
            "registry",
            "field",
            "effect",
            "trigger",
            "modifier",
            "modifier_category",
            "modifier_family",
            "scope",
            "scope_group",
            "scope_link",
            "localization_context",
            "localization_command",
            "localization_link",
            "on_action",
            "game_rule",
            "define",
            "inventory"
          ]
        },
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "conditional": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "registry"
            }
          },
          "required": [
            "registry"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "field"
                ]
              },
              {
                "required": [
                  "conditional"
                ]
              },
              {
                "required": [
                  "name"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "field"
            }
          },
          "required": [
            "registry",
            "field",
            "conditional"
          ],
          "not": {
            "required": [
              "name"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "effect",
                "trigger",
                "modifier",
                "modifier_category",
                "modifier_family",
                "scope",
                "scope_group",
                "scope_link",
                "localization_context",
                "localization_command",
                "localization_link",
                "on_action",
                "game_rule",
                "define",
                "inventory"
              ]
            }
          },
          "required": [
            "name"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "registry"
                ]
              },
              {
                "required": [
                  "field"
                ]
              },
              {
                "required": [
                  "conditional"
                ]
              }
            ]
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z_]+:[^#]+#[a-z][a-z0-9._]*$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "not": {
            "type": "null"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "subject",
        "property",
        "conditions",
        "answer",
        "evidence"
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z_]+:[^#]+#[a-z][a-z0-9._]*$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^SDK-[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_gap"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "subject",
        "property",
        "reason",
        "owner",
        "native_gaps",
        "evidence"
      ]
    }
  }
}
