{
  "illustrativeOnly": true,
  "note": "Fictional structural example; not a production snapshot or an established Stellaris rule.",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pdx-atlas:example:mode-value",
    "$defs": {
      "numericValue": { "type": "number" },
      "fixed": {
        "type": "object",
        "properties": {
          "mode": { "const": "fixed" },
          "value": { "$ref": "#/$defs/numericValue" }
        },
        "required": ["mode", "value"]
      },
      "unfixed": {
        "type": "object",
        "properties": {
          "mode": { "const": "unfixed" },
          "value": { "$ref": "#/$defs/numericValue" }
        },
        "required": ["mode"]
      }
    },
    "oneOf": [
      { "$ref": "#/$defs/fixed" },
      { "$ref": "#/$defs/unfixed" }
    ]
  },
  "cases": [
    { "input": { "mode": "fixed", "value": 10 }, "valid": true },
    { "input": { "mode": "fixed" }, "valid": false },
    { "input": { "mode": "unfixed" }, "valid": true },
    { "input": { "mode": "unfixed", "value": 10 }, "valid": true },
    { "input": { "mode": "unfixed", "value": "ten" }, "valid": false },
    { "input": { "mode": "other", "value": 10 }, "valid": false },
    { "input": { "value": 10 }, "valid": false },
    { "input": {}, "valid": false }
  ],
  "separateOccurrenceExample": {
    "field": "example.repeated_value",
    "valueSchema": { "type": "number" },
    "occurrences": { "min": 0, "max": 2 },
    "cases": [
      {
        "authoredEntries": [
          { "key": "repeated_value", "operator": "=", "value": 1 },
          { "key": "repeated_value", "operator": "=", "value": 2 }
        ],
        "occurrencesValid": true,
        "eachValueValid": true
      },
      {
        "authoredEntries": [
          { "key": "repeated_value", "operator": "=", "value": [1, 2] }
        ],
        "occurrencesValid": true,
        "eachValueValid": false
      },
      {
        "authoredEntries": [
          { "key": "repeated_value", "operator": "=", "value": 1 },
          { "key": "repeated_value", "operator": "=", "value": 2 },
          { "key": "repeated_value", "operator": "=", "value": 3 }
        ],
        "occurrencesValid": false,
        "eachValueValid": true
      }
    ]
  }
}
